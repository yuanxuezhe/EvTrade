# EvTrade backend configuration
# 服务端凭证（git 忽略）：RabbitMQ / RPC / HQ 行情

# ---- RabbitMQ (xtquant RPC) ----
EVTRADE_RABBITMQ_URL=amqp://192.168.10.2:5672/
EVTRADE_EXCHANGE_NAME=msgpacket.exchange
EVTRADE_QUEUE_REQ=EvTrade.Test.Req
EVTRADE_QUEUE_REPLY=EvTrade.Test.Reply
EVTRADE_QUEUE_PUSH=EvTrade.Test.Push

# ---- RPC ----
EVTRADE_RPC_TIMEOUT=30

# ---- FastAPI ----
EVTRADE_API_HOST=0.0.0.0
EVTRADE_API_PORT=8000

# ---- hq/hqserverd (Rust 行情消费 + WS 推送) ----
# 2026-08-18: 旧 hqserver.py (RabbitMQ) 改写为 Rust 二进制 (hq/hqserverd) + UDP。
#   前端 WS 协议/端口保持不变 (:8765)。
HQ_UDP_BIND=0.0.0.0:9001
QUOTA_UDP_HOST=192.168.10.2
QUOTA_UDP_PORT=9001
HQ_NUM_WORKERS=4
HQ_MAX_QUEUE_SIZE=5000
HQ_WS_HOST=0.0.0.0
HQ_WS_PORT=8765

# quota_his
EVTRADE_HIS_HQ_RABBITMQ_URL=amqp://192.168.10.2:5672/
EVTRADE_HIS_HQ_EXCHANGE_NAME=quota_his.exchange
EVTRADE_HIS_HQ_REQ_QUEUE=EvTrade.ReqHisHq

# ---- Strategy engine (quote 推送 for /ws/quote_update) ----
STRATEGY_ENGINE_ENABLED=1

# ---- Database (REQ-CFG-009, 2026-07-08 sqlite -> mysql) ----
EVTRADE_DB_URL=mysql+pymysql://EvTrade:p%40ssw0rd@192.168.10.2:33066/evtrade_dev?charset=utf8mb4
EVTRADE_DB_POOL_SIZE=5
EVTRADE_DB_MAX_OVERFLOW=10
EVTRADE_DB_POOL_RECYCLE=1800
EVTRADE_DB_POOL_PRE_PING=true

EVTRADE_HIS_HQ_FALLBACK_DEMO=0
EVTRADE_ALLOW_GRANT_TOKEN=1
