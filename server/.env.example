# EvTrade backend configuration
# Copy to .env and adjust as needed.

# ---- RabbitMQ ----
EVTRADE_RABBITMQ_URL=amqp://192.168.10.2:5672/
EVTRADE_EXCHANGE_NAME=msgpacket.exchange
EVTRADE_QUEUE_REQ=EvTrade.Test.Req
EVTRADE_QUEUE_REPLY=EvTrade.Test.Reply
EVTRADE_QUEUE_PUSH=EvTrade.Test.Push

# ---- RPC ----
EVTRADE_RPC_TIMEOUT=30

# ---- FastAPI ----
EVTRADE_API_HOST=0.0.0.0
EVTRADE_API_PORT=8001

# ---- Database (REQ-CFG-009) ----
# SQLAlchemy URL. driver=pymysql (纯 Python, 跨平台零编译)
# 用户名密码里的特殊符号必须 url-encode: @ → %40, # → %23
EVTRADE_DB_URL=mysql+pymysql://EvTrade:p%40ssw0rd@127.0.0.1:33066/evtrade?charset=utf8mb4

# DDL-only URL（init_db 一次性建表用 — 部署完即可删除避免误用）
# 若不设则降级用 EVTRADE_DB_URL，但业务账号若只 DML 会拒绝 CREATE。
#EVTRADE_DB_ADMIN_URL=mysql+pymysql://root:p%40ssw0rd@127.0.0.1:33066/evtrade?charset=utf8mb4

# Pool config（MySQL only；SQLite 走 StaticPool 忽略这些）
EVTRADE_DB_POOL_SIZE=5
EVTRADE_DB_MAX_OVERFLOW=10
EVTRADE_DB_POOL_RECYCLE=1800
EVTRADE_DB_POOL_PRE_PING=true

# ---- Security (REQ-CFG-006) ----
# JWT 签名密钥。建议：多实例部署必填（保证 token 共享）；单实例可留空，
# 系统会自动用 secrets.token_urlsafe(64) 生成并写入 server/auth/.secret_key
# EVTRADE_SECRET=<REQUIRED for multi-instance>

# ---- hq/hqserverd (Rust 行情消费 + WS 推送) ----
# 2026-08-18: 旧版 hq/hqserver.py 改写为 Rust 二进制 (hq/hqserverd),
#   去掉 RabbitMQ 中转, 改为 UDP 直推 (QMT quota.py -> hqserverd)。
#   前端 WS 协议/端口保持不变 (:8765, payload 格式不变)。
#
# hqserverd 监听端口 (默认 UDP 9001)
HQ_UDP_BIND=0.0.0.0:9001
# quota.py 推送目标地址 (QMT 进程与 hqserverd 一般跨机部署, 默认指向内网 IP)
QUOTA_UDP_HOST=192.168.1.20
QUOTA_UDP_PORT=9001

# hqserverd 并发模型
HQ_NUM_WORKERS=4
HQ_MAX_QUEUE_SIZE=5000

# hqserverd WebSocket 推前端 (前端无改动)
HQ_WS_HOST=0.0.0.0
HQ_WS_PORT=8765

# ---- 历史 K 线 (server/strategy/runtime/his_hq.py) ----
# 回测从 broker 拉历史数据走的独立 RabbitMQ 通道
# 请求队列固定为 EvTrade.ReqHisHq (broker 端 his_hq 应答服务消费此队列)
EVTRADE_HIS_HQ_RABBITMQ_URL=amqp://192.168.10.2:5672/
EVTRADE_HIS_HQ_EXCHANGE_NAME=quota_his.exchange
EVTRADE_HIS_HQ_REQ_QUEUE=EvTrade.ReqHisHq
EVTRADE_HIS_HQ_TIMEOUT=30
# broker 凭据 (默认 guest/guest)
EVTRADE_HIS_HQ_USER=guest
EVTRADE_HIS_HQ_PASSWORD=guest
# broker his_hq 不响应时是否启用 demo 数据源 (1=启用, 用于本地体验完整回测流程)
EVTRADE_HIS_HQ_FALLBACK_DEMO=0
