# EvTrade backend configuration
# Copy to .env and adjust as needed.

# ---- RabbitMQ ----
EVTRADE_RABBITMQ_URL=amqp://192.168.10.2:5672/
EVTRADE_EXCHANGE_NAME=msgpacket.exchange
EVTRADE_QUEUE_REQ=EvTrade.Test.Req
EVTRADE_QUEUE_REPLY=EvTrade.Test.Reply
EVTRADE_QUEUE_PUSH=EvTrade.Test.Push

# ---- RPC ----
EVTRADE_RPC_TIMEOUT=30

# ---- FastAPI ----
EVTRADE_API_HOST=0.0.0.0
EVTRADE_API_PORT=8001

# ---- Database (REQ-CFG-009) ----
# SQLAlchemy URL. driver=pymysql (纯 Python, 跨平台零编译)
# 用户名密码里的特殊符号必须 url-encode: @ → %40, # → %23
# 本地开发想用 SQLite 替代: EVTRADE_DB_URL=sqlite:///./evtrade.db
# MySQL 容器端口 127.0.0.1:33066 (仅本地回环, 不暴露公网)
EVTRADE_DB_URL=mysql+pymysql://EvTrade:p%40ssw0rd@127.0.0.1:33066/evtrade?charset=utf8mb4
EVTRADE_DB_POOL_SIZE=5
EVTRADE_DB_MAX_OVERFLOW=10
EVTRADE_DB_POOL_RECYCLE=1800
EVTRADE_DB_POOL_PRE_PING=true

# ---- Security (REQ-CFG-006) ----
# JWT 签名密钥。建议：多实例部署必填（保证 token 共享）；单实例可留空，
# 系统会自动用 secrets.token_urlsafe(64) 生成并写入 server/auth/.secret_key
# EVTRADE_SECRET=<REQUIRED for multi-instance>

# ---- hq/hqserver.py (行情消费 + WS 推送) ----
HQ_RABBITMQ_URL=amqp://192.168.10.2:5672/
HQ_EXCHANGE_NAME=quota.exchange
HQ_SOURCE_QUEUE=EvQuota
HQ_BROADCAST_EXCHANGE=quota.broadcast.exchange
HQ_NUM_WORKERS=4
HQ_MAX_QUEUE_SIZE=5000
HQ_PREFETCH_COUNT=16
HQ_WS_HOST=0.0.0.0
HQ_WS_PORT=8765
