# strategy_exec/.env.example
# 复制到 .env 后填实际值（.env 已加入 .gitignore）

# ──── 服务端口 ────
STRATEGY_EXEC_PORT=8001
STRATEGY_EXEC_HOST=0.0.0.0
STRATEGY_EXEC_API_TOKEN=__SET_RANDOM_32_CHARS__

# ──── MySQL（与 EvTrade 共享同库）────
EVTRADE_DB_URL=mysql+pymysql://EvTrade:p%40ssw0rd@192.168.10.2:33066/evtrade?charset=utf8mb4
EVTRADE_DB_POOL_SIZE=5
EVTRADE_DB_MAX_OVERFLOW=10
EVTRADE_DB_POOL_RECYCLE=1800
EVTRADE_DB_POOL_PRE_PING=true

# ──── RabbitMQ（与 EvTrade 共享同 broker）────
EVTRADE_RABBITMQ_URL=amqp://192.168.10.2:5672/

# signal 推送（strategy → evtrade）
EVTRADE_STRATEGY_EXCHANGE_NAME=strategy.exchange
EVTRADE_STRATEGY_SIGNAL_QUEUE=EvTrade.StrategySignal
EVTRADE_STRATEGY_PUBLISH_CONFIRM_TIMEOUT=5
EVTRADE_STRATEGY_PUBLISH_RETRIES=3

# broker his_hq（回测历史 K 线）
EVTRADE_HIS_HQ_EXCHANGE_NAME=quota_his.exchange
EVTRADE_HIS_HQ_REQ_QUEUE=EvTrade.ReqHisHq
EVTRADE_HIS_HQ_REQ_TIMEOUT=30

# ──── 行情（直连 hqserver，不走 EvTrade）────
HQ_WS_URL=ws://127.0.0.1:8765/quota.broadcast
HQ_WS_RECONNECT_BASE_DELAY=1000
HQ_WS_RECONNECT_MAX_DELAY=30000
HQ_WS_HEARTBEAT_INTERVAL=30

# ──── 沙箱 ────
SANDBOX_BLOCKED_MODULES=os.system,subprocess,open,socket,requests,urllib,http.client
SANDBOX_ALLOWED_MODULES=backtrader,numpy,pandas,math,json,datetime,typing

# ──── 日志 ────
LOG_LEVEL=INFO
LOG_FILE=/var/log/strategy_exec.log